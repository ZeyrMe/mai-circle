# Generated from config_models.py; instance config.toml stays local.
show_advanced = false
enabled = true
group_sets = []
people = []
admins = []
master_persona_hint = "最铁的老熟人"
relation_template = "{name}：{relation_tag} {custom_note}"
bot_template = "{name}：{owner_name}家的{bot_role}；{custom_note}"
master_template = "{name}：{master_persona_hint}"
hint_chars = 55

[scope]
mode = "all"
groups = []
privates = []
users = []
exclude = []
allow_private = true
reference_cache_seconds = 60
api_timeout_seconds = 0.4
max_tracked_streams = 256

[plugin]
config_version = "0.1.0"
